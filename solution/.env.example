# Variables d'environnement pour compose.prod.yaml (la "prod").
# Copiez ce fichier dans le dossier de déploiement : cp .env.example ~/taskflow-prod/.env
# Le vrai fichier .env est ignoré par Git. Protégez-le : chmod 600 .env
#
# (compose.yaml, lui, fonctionne sans .env grâce à ses valeurs par défaut.)

# --- Base de données ---------------------------------------------------------
# Mot de passe PostgreSQL. En production : un mot de passe long et aléatoire
# (par exemple : openssl rand -hex 24). Attention, il doit être répété dans DATABASE_URL.
POSTGRES_PASSWORD=changez-moi

# Utilisé par l'API (compose.prod.yaml transmet tout le .env au conteneur "api").
# Notez l'hôte "db" : c'est le nom du service dans compose.prod.yaml.
# Le nom de la variable doit être EXACTEMENT DATABASE_URL.
DATABASE_URL=postgres://taskflow:changez-moi@db:5432/taskflow

# --- API ---------------------------------------------------------------------
APP_ENV=production

# --- Images ------------------------------------------------------------------
# Propriétaire GitHub des images ghcr.io, EN MINUSCULES (ghcr.io refuse les majuscules).
GHCR_OWNER=votre-compte-github

# Version à lancer : SHA court d'un commit (ex: a1b2c3d) ou "latest".
# deploy.sh la fournit lui-même à chaque déploiement.
IMAGE_TAG=latest

# --- Ports publiés par le proxy ----------------------------------------------
# Valeurs par défaut : 80 et 443. Changez-les si ces ports sont déjà utilisés
# sur votre machine (ex: 8081 et 8443).
HTTP_PORT=80
HTTPS_PORT=443
