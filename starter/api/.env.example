# Variables d'environnement de l'API.
# Les valeurs ci-dessous sont aussi les valeurs PAR DÉFAUT du code (src/config.js) :
# en local, vous n'avez donc rien à configurer. Ce fichier sert de documentation.
#
# Pour les utiliser vraiment : cp .env.example .env  puis  export $(grep -v '^#' .env | xargs)
# (le vrai fichier .env est ignoré par Git : ne le commitez jamais)

# Port d'écoute de l'API
PORT=3000

# Adresse de la base PostgreSQL : postgres://utilisateur:motdepasse@hôte:port/base
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow

# Environnement : local ou production
APP_ENV=local

# Version affichée par /health (en CI, elle est remplacée par le SHA court du commit)
APP_VERSION=dev
